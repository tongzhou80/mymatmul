# Copy this file to .env and set the GPU index for your machine.
# .env is gitignored — each machine has its own copy.
#
# Examples:
#   RTX 4090 lab machine  -> CUDA_VISIBLE_DEVICES=0
#   H800 cluster GPU 2    -> CUDA_VISIBLE_DEVICES=2
#
# All code uses the default "cuda" device, which maps to index 0 of whatever
# GPUs are visible here.  No code changes are needed when switching machines.

CUDA_VISIBLE_DEVICES=0
